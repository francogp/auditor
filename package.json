{
  "name": "@francogp/auditor",
  "version": "1.0.0",
  "description": "High-performance, generic static analysis and architecture audit engine with Antigravity AI skills and environment governance",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "license": "MIT",
  "author": "Franco Gastón Pellegrini",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francogp/auditor.git"
  },
  "bugs": {
    "url": "https://github.com/francogp/auditor/issues"
  },
  "homepage": "https://github.com/francogp/auditor#readme",
  "files": [
    "src",
    "skills",
    "rules",
    "plugin.json",
    "setup-linux.sh",
    "setup-windows.ps1",
    "scripts/setup",
    "audit.config.ts",
    ".htmlvalidate.json",
    ".markdownlint.json",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=26.10.0",
    "npm": ">=12.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./base": "./src/core/auditorBase.ts",
    "./config": "./src/core/auditConfig.ts",
    "./contract": "./src/core/auditContract.ts",
    "./theme": "./src/core/unifiedTheme.ts",
    "./plugin": "./src/plugin/defineAuditorExtension.ts",
    "./suites/*": "./src/suites/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "auditor": "./src/cli/audit_full.ts",
    "auditor-commit": "./src/cli/audit_for_commit.ts",
    "auditor-bundle": "./src/cli/audit_bundle.ts",
    "auditor-findings": "./src/cli/report_findings.ts",
    "auditor-report-findings": "./src/cli/report_findings.ts",
    "auditor-fallow": "./src/cli/report_fallow.ts",
    "auditor-complexity": "./src/cli/report_complexity.ts",
    "auditor-init-agent": "./src/cli/init_agent.ts",
    "auditor-sync-env": "./src/cli/sync_env_scripts.ts",
    "auditor-check-env": "./src/cli/check_environment.ts",
    "auditor-setup-env": "./src/cli/setup_env.ts"
  },
  "scripts": {
    "preinstall": "node --experimental-strip-types src/cli/check_environment.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "node --permission --experimental-strip-types --allow-fs-read=* --allow-fs-write=* --allow-child-process --allow-addons src/cli/audit_full.ts",
    "audit:for-commit": "node --permission --experimental-strip-types --allow-fs-read=* --allow-fs-write=* --allow-child-process --allow-addons src/cli/audit_for_commit.ts",
    "audit:bundle": "node --permission --experimental-strip-types --allow-fs-read=* --allow-fs-write=* src/cli/audit_bundle.ts",
    "audit:md": "node --permission --experimental-strip-types --allow-fs-read=* --allow-fs-write=* --allow-child-process --allow-addons src/cli/audit_full.ts preset=md",
    "lint:md": "node --permission --experimental-strip-types --allow-fs-read=* --allow-fs-write=* --allow-child-process src/suites/documentation/validate_markdown_lint.ts",
    "audit:findings": "node --permission --experimental-strip-types --allow-fs-read=* --allow-fs-write=* src/cli/report_findings.ts",
    "validate:dox-integrity": "node --permission --experimental-strip-types --allow-fs-read=* --allow-fs-write=* src/suites/documentation/validate_dox_integrity.ts",
    "validate:agent-plugin": "node --permission --experimental-strip-types --allow-fs-read=* --allow-fs-write=* src/suites/architecture/validate_agent_plugin.ts",
    "init-agent": "node --experimental-strip-types src/cli/init_agent.ts",
    "sync:env": "node --experimental-strip-types src/cli/sync_env_scripts.ts",
    "env:setup": "node --experimental-strip-types src/cli/setup_env.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "audit:fallow": "fallow health --score"
  },
  "dependencies": {
    "css-checker-kit": "^0.4.2",
    "fallow": "^3.28.0",
    "html-validate": "^11.16.1",
    "html-validate-vue": "^9.3.1",
    "markdownlint-cli": "^0.49.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "jsdom": "^30.1.1",
    "vitest": "^5.0.1"
  }
}
