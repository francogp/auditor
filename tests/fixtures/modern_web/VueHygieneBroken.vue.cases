<template>
  <div class="vue-hygiene-fixture">
    <ul>
      <li v-for="item in items.sort()" :key="item">{{ item }}</li>
    </ul>
    <p>{{ tags.reverse().join(', ') }}</p>
  </div>
</template>
<script setup lang="ts">
import { ref } from 'vue';

const items = ref(['b', 'a']);
const tags = ref(['one', 'two']);

function handleChatSubmitKeydown(e: KeyboardEvent): void {
  if (e.key === 'Enter') {
    submitMessage();
  }
}

function submitMessage(): void {
  items.value.push('sent');
}
</script>
